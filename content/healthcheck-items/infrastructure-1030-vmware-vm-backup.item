version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "vSphere"
  severity_key: "Not defined"
  tags: []
  description: "Backups"
  references: 
  - title: "Backup and restore"
    url: "https://docs.openshift.com/container-platform/latest/backup_and_restore/index.html"
  check_procedures:
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "survey"
      question: "Inquire the client if VMs are being backed up."
    - type: "survey"
      question: "What backup solution is currently implemented for the Kubernetes cluster?"
    - type: "survey"
      question: "What is the current backup schedule and retention policy?"
    - type: "survey"
      question: "Are etcd backups being performed regularly?"
    - type: "survey"
      question: "How are persistent volumes being backed up?"
    - type: "survey"
      question: "What is the disaster recovery plan for the cluster?"
    - type: "survey"
      question: "Have backup restores been tested recently?"
  common_outcomes:
  - key: "advisory01"
    scenario_description_short_text: "Se requieren pruebas de respaldo"
    description_long_text: "Pruebas de restauración de respaldo regular no implementadas"
    impact_and_risk_text: "Confiabilidad desconocida del proceso de restauración de respaldo"
    remediation_text: "Implementar pruebas regulares de restauración de copias de seguridad"
  - key: "advisory02"
    scenario_description_short_text: "Se necesita revisión de la estrategia de respaldo"
    description_long_text: "La estrategia de respaldo actual necesita una evaluación."
    impact_and_risk_text: "Posibles brechas en la cobertura de respaldo"
    remediation_text: "Revisar y optimizar la estrategia de respaldo"
  - key: "no_change01"
    scenario_description_short_text: "Solución de respaldo integral"
    description_long_text: "Solución de copia de seguridad completa implementada con pruebas regulares"
    impact_and_risk_text: "Riesgo mínimo de pérdida de datos"
    remediation_text: "Continuar los procedimientos de copia de seguridad actuales"
  - key: "no_change02"
    scenario_description_short_text: "Configuración de copia de seguridad óptima"
    description_long_text: "La estrategia de respaldo sigue las mejores prácticas con restauraciones verificadas"
    impact_and_risk_text: "Perfil de bajo riesgo para la protección de datos"
    remediation_text: "Mantener la configuración actual"
  - key: "changes_recommended01"
    scenario_description_short_text: "Cobertura de respaldo insuficiente"
    description_long_text: "Las máquinas virtuales no están respaldadas o una solución de respaldo inadecuada"
    impact_and_risk_text: "Alto riesgo de pérdida de datos y tiempo de inactividad extendido"
    remediation_text: "Implementar una solución de respaldo integral"
  - key: "changes_recommended02"
    scenario_description_short_text: "Se requiere automatización de copia de seguridad"
    description_long_text: "Procesos de copia de seguridad manuales en su lugar"
    impact_and_risk_text: "Riesgo de copias de seguridad perdidas y error humano"
    remediation_text: "Implementar una solución de copia de seguridad automatizada"
customer_environment_findings:
