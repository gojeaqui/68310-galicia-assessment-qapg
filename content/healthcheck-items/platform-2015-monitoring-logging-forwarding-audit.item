version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Monitoring & Logging"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Observability"
    - "Security"
  description: "Forward OpenShift audit logs to external logging system"
  references: 
  - title: "Forwarding logs to external third-party logging systems"
    url: "https://docs.openshift.com/container-platform/latest/observability/logging/log_collection_forwarding/configuring-log-forwarding.html"
  - title: "Understanding cluster logging"
    url: "https://docs.openshift.com/container-platform/latest/observability/logging/cluster-logging.html"
  check_procedures:
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "survey"
      question: "Does the organization require that audit logs are sent to a logging system external to OpenShift?"
    - type: "survey"
      question: "Are audit logs being forwarded to an external logging system?"
    - type: "command"
      question: "find out the forwarding configs in openshift-logging namespace"
      command: |
        # 'Review the output under "status" for fluentd pods, logs
        oc get clusterlogging instance -n openshift-logging -o yaml
        oc get clusterlogforwarder -n openshift-logging -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "Log Forwarding configured"
    description_long_text: "Log forwarding is configured for the OpenShift audit pipeline to an external logging system"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "changes_recommended01"
    scenario_description_short_text: "Log Forwarding not configured"
    description_long_text: "Log forwarding is not configured for the OpenShift audit pipeline to an external logging system"
    impact_and_risk_text: "An external logging system protects the confidentiality, integrity, and availability of audit logs"
    remediation_text: "Configure external log forwarding for audit logs"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""

