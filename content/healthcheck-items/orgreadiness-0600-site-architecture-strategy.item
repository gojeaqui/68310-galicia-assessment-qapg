  check_procedures:
    - type: survey
      question: "Have you considered multi-cloud or hybrid cloud strategies for you containerized applications?"
    - type: survey
      question: "What cloud providers are currently in use or planned?"
    - type: survey
      question: "How do you manage workload distribution across clouds?"
    - type: survey
      question: "What is your disaster recovery strategy across clouds?"
    - type: survey
      question: "How do you handle data sovereignty requirements?"
    - type: survey
      question: "What tools do you use for multi-cloud management?"
    - type: survey
      question: "How do you maintain consistency across cloud environments?"
