    - key: "advisory02"
      scenario_description_short_text: "Multi-cloud Strategy Review"
      description_long_text: "Current multi-cloud approach needs assessment"
      impact_and_risk_text: "Potential gaps in cloud strategy"
      remediation_text: "Review and optimize multi-cloud strategy"
    - key: "no_change01"
      scenario_description_short_text: "Effective Multi-cloud Strategy"
      description_long_text: "Well-planned multi-cloud implementation"
      impact_and_risk_text: "Good cloud diversity and redundancy"
      remediation_text: "Maintain current cloud strategy"
    - key: "no_change02"
      scenario_description_short_text: "Strong Cloud Management"
      description_long_text: "Effective multi-cloud management practices"
      impact_and_risk_text: "Consistent cross-cloud operations"
      remediation_text: "Continue current management approach"
    - key: "changes_recommended01"
