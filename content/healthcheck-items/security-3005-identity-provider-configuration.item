version: v2
check_definition:
  category_key: "security"
  subcategory_key: "Identity"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "Identity Provider Type/Configuration"
  references: 
  - title: "Understanding identity provider configuration"
    url: "https://docs.openshift.com/container-platform/latest/authentication/understanding-identity-provider.html"
  check_procedures:
    - type: compliance_operator
      profile: none
      rule: none
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "command"
      command: |
        oc get OAuth cluster -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "La autenticación la gestiona el proveedor de identidad"
    description_long_text: "La autenticación se gestiona a nivel de organización"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "Enterprise authentication not available"
    description_long_text: "Enterprise authentication, so users may use the same user/pass as enterprise auth"
    impact_and_risk_text: "External Identities not configured, may not be configured to standard enterprise auth"
    remediation_text: "Implement more robust authentication"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
