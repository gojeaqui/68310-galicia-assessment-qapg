version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Monitoring & Logging"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Observability"
    - "Administration"
    - "Security"
  description: "Ensure all OpenShift alerts are reviewed, addressed or silenced"
  references: 
  - title: "Managing alerts"
    url: "https://docs.openshift.com/container-platform/latest/monitoring/managing-alerts.html"
  check_procedures:
    - type: gui_action
      steps: 
      - "verify alerts by clicking observe > alerting in console UI"
    - type: "survey"
      question: "is the cluster sending alerts?"
    - type: "survey"
      question: "Are all the pods mounted in openshift-monitoring namespace running fine or do you see broken pods?"
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "Openshift alerting is configured"
    description_long_text: "OpenShift alerts provide information to administrators about the status of the cluster. All alerts have been properly addressed."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "changes_required01"
    scenario_description_short_text: "OpenShift tiene alertas activas sin atender"
    description_long_text: "Las alertas de OpenShift proporcionan información a los administradores sobre el estado del clúster. Algunas alertas están en estado \"firing\" y no han sido atendidas."
    impact_and_risk_text: "Las alertas activas pueden indicar un fallo inminente o simplemente proporcionar información según la gravedad de la alerta. Las alertas críticas deben atenderse y resolverse inmediatamente para evitar interrupciones de la plataforma o una degradación del rendimiento. Otras alertas, como las de tipo 'INFO', pueden silenciarse una vez revisadas"
    remediation_text: "Revisar todas las alertas y remediarlas o silenciarlas según sea necesario"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: changes_recommended
  common_outcome_key: "changes_required01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [guillermo@darkstar paas1-qapg]$ omc prom rules -s firing,pending -o wide
    GROUP                                         RULE                                        SEVERITY   STATE    AGE   ALERTS   ACTIVE SINCE
    vsphere-problem-detector.rules                VSphereOpenshiftClusterHealthFail           warning    firing   22s   1        07 Aug 26 14:48 UTC
    cluster-version                               UpdateAvailable                             info       firing   6s    1        29 Aug 26 04:48 UTC
    openshift-ingress-to-route-controller.rules   IngressWithoutClassName                     warning    firing   19s   6        31 Aug 26 11:13 UTC
    insights                                      InsightsRecommendationActive                info       firing   18s   3        26 Aug 26 12:40 UTC
    general.rules                                 Watchdog                                    none       firing   3s    1        26 Aug 26 12:40 UTC
    openshift-kubernetes.rules                    ClusterMonitoringOperatorDeprecatedConfig   info       firing   12s   1        01 Jul 26 14:26 UTC

# Estas alertas son importantes:
# - VSphereOpenshiftClusterHealthFail
