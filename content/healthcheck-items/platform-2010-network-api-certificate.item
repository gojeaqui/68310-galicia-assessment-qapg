version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
    - "Security"
  description: "API Certificate"
  references: 
  - title: "User-provided certificates for the API server"
    url: "https://docs.redhat.com/en/documentation/openshift_container_platform/4.20/html/security_and_compliance/configuring-certificates#api-server-certificates"
  check_procedures:
    - type: command
      command: | 
        oc get apiserver cluster -o yaml
        oc get secrets -n openshift-config
  common_outcomes:
    - key: "recommend01"
      scenario_description_short_text: "Certificados auto-firmados"
      description_long_text: "Se están utilizando certificados auto-firmados."
      impact_and_risk_text: "Los certificados auto-firmados muestran advertencias en los navegadores y es difícil verificar si son auténticos. Esto puede presentar un problema de seguridad, ya que los usuarios no pueden estar seguros de la identidad del clúster de OpenShift ni de si su comunicación con el clúster está correctamente cifrada."
      remediation_text: "Se recomienda adquirir certificados de una Autoridad de Certificación interna o externa de confianza y seguir los procedimientos documentados para instalarlos en todos los clústeres."
    - key: "nochange01"
      scenario_description_short_text: "Certificados de confianza."
      description_long_text: "Se esta utilizando un certificado de confianza emitido por una Autoridad de Certificación interna."  
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "nochange01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
