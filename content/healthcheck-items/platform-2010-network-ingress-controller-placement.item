version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  description: "Ingress Controller placement"
  tag_keys:
    - "Openshift Cluster Configuration"
  references: 
  - title: "Ingress Controller placement"
    url: "https://docs.openshift.com/container-platform/latest/networking/ingress-operator.html"
  check_procedures:
    - type: command
      command: |
        oc get ingresscontroller --all-namespaces -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "El nodePlacement está definido"
    description_long_text: "El IngressController tiene el nodePlacement definido, lo que impide que el controlador se programe en nodos de trabajo."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "nodePlacement is incorrect"
    description_long_text: "IngressController has not defined nodePlacement, the default values are used instead."
    impact_and_risk_text: "Ingress may float into worker nodes"
    remediation_text: "Add nodePlacement and tolerations to the IngressController"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
