version: v2
check_definition:
  category_key: "security"
  subcategory_key: "Identity"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "LDAP Identity Provider id Attribute must be an immutable LDAP attribute."
  references: 
  - title: "Configuring an LDAP identity provider"
    url: "https://docs.openshift.com/container-platform/latest/authentication/identity_providers/configuring-ldap-identity-provider.html#identity-provider-ldap-CR_configuring-ldap-identity-provider"
  check_procedures:
    - type: compliance_operator
      profile: none
      rule: none
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "command"
      question: ""
      command: |
        oc get OAuth cluster -o yaml
    - type: "survey"
      question: "Check the attributes for the LDAP Identity Provider.  The id attribute should reference an LDAP attribute.  Is that LDAP Attribute immutable?"
  common_outcomes:
  - key: "nochange_01"
    scenario_description_short_text: "El atributo id de LDAP es inmutable"
    description_long_text: "El atributo id del proveedor de identidad basado en LDAP es un atributo LDAP inmutable."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "required01"
    scenario_description_short_text: "El atributo id de LDAP no es inmutable"
    description_long_text: "El atributo utilizado como id por el proveedor de identidad basado en LDAP no es un atributo LDAP inmutable. En la configuración actual se utiliza el atributo cn de Active Directory."
    impact_and_risk_text: "Si el atributo utilizado como id cambia para un usuario, OpenShift puede considerar que se trata de una identidad diferente y el usuario podría quedar imposibilitado para iniciar sesión con su identidad anterior. Esto puede afectar especialmente a usuarios con privilegios administrativos sobre el clúster."
    remediation_text: "Se recomienda seleccionar un atributo de Active Directory que sea inmutable durante toda la vida de la cuenta del usuario y utilizarlo como atributo id del proveedor de identidad LDAP. En este caso, se debe evaluar el uso de sAMAccountName como alternativa a cn, siempre que las políticas y el esquema del Active Directory garanticen que dicho atributo no cambia. Antes de realizar la modificación, se debe validar el comportamiento de las identidades existentes y definir un procedimiento de cambio que evite bloquear el acceso de los usuarios, especialmente de los administradores del clúster. "
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "nochange_01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
