version: v2
check_definition:
  category_key: "appdev"
  subcategory_key: "Production"
  severity_key: "Not defined"
  tags: []
  description: "Application count in production"
  references:
    - title: "Object Maximums"
      url: "https://docs.openshift.com/container-platform/latest/scalability_and_performance/planning-your-environment-according-to-object-maximums.html"
  check_procedures:
    - type: survey
      question: "How many applications are in production?"
    - type: survey
      question: "Are there any specific SLAs that your applications must adhere to?"
    - type: command
      command: |
        oc get deployments --all-namespaces
        oc get pods --all-namespaces
        oc get services --all-namespaces
        oc get routes --all-namespaces
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Information Only"
      description_long_text: ""  # Consultant to fill out application load details
      impact_and_risk_text: ""
      remediation_text: ""
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses.
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
    scenario_description_short_text: ""
    description_long_text: ""
    impact_and_risk_text: ""
    remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
