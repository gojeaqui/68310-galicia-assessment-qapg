version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Disaster Recovery"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "etcd"
    - "Security"
  description: "etcd Encryption Enabled"
  references: 
  - title: "Encrypting etcd data"
    url: "https://docs.openshift.com/container-platform/latest/security/encrypting-etcd.html"
  check_procedures:
    - type: compliance_operator
      profile: none
      rule: none
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "command"
      question: ""
      command: |
        # If the return is blank then ECTD has not been encrypted
        oc get openshiftapiserver -o=jsonpath='{range .items[0].status.conditions[?(@.type=="Encrypted")]}{.reason}{"\n"}{.message}{"\n"}'
  common_outcomes:
  - key: "nochange_01"
    scenario_description_short_text: "ECTD encryption enabled"
    description_long_text: "etcd data encryption is enabled and no further actions are required."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "recommend01"
    scenario_description_short_text: "Cifrado de etcd no habilitado"
    description_long_text: "El cifrado de datos de etcd no está habilitado de forma predeterminada y debe configurarse por cliente"
    impact_and_risk_text: "Si etcd no está cifrado, puede producirse una pérdida de datos confidenciales si una copia de seguridad de etcd queda expuesta a personas no autorizadas"
    remediation_text: "Cada clúster de OpenShift debería tener habilitado el cifrado de etcd como capa adicional de seguridad"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: changes_recommended
  common_outcome_key: "recommend01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [guillermo@darkstar paas-apps1-qapg]$ omc get openshiftapiserver -o=jsonpath='{range .items[0].status.conditions[?(@.type=="Encrypted")]}{.reason}{"\n"}{.message}{"\n"}'
    [guillermo@darkstar paas-apps1-qapg]$
    ---
