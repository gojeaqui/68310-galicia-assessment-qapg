version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Common"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Install"
  description: "install-config.yaml Configuration"
  references: 
  - title: "Configuring the install-config.yaml file"
    url: "https://docs.openshift.com/container-platform/latest/installing/installing_bare_metal_ipi/ipi-install-installation-workflow.html#additional-resources_config"
  check_procedures:
    - type: command
      command: |
        oc describe cm -n kube-system cluster-config-v1
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Configuracion de 'install-config.yaml' generalmente correcta" 
      description_long_text: "En general no se encontraron problemas salvo el hecho de que se colocaron varios keys en los nodos"  # Consultant to describe state of install-config
      impact_and_risk_text: "No se recomienda ingresar a los nodos mediante SSH sino utilizando 'oc debug node/<nodo>' y el uso de multiples llaves SSH afecta la seguridad de los nodos porque eso genera un problema en el manejo de la seguridad de las llaves"
      remediation_text: "Se recomienda utilizar una sola llave y evitar esta practica para la creación de clusters futuros"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: changes_recommended
  common_outcome_key: "advisory01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc describe cm -n kube-system cluster-config-v1
