version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  description: "Review Load Balancer Balancing Algorithm"
  references: 
  - title: "Load balancing requirements"
    url: "https://docs.openshift.com/container-platform/latest/installing/installing_platform_agnostic/installing-platform-agnostic.html#installation-load-balancing-user-infra_installing-platform-agnostic"
  check_procedures: 
    - type: "survey"
      question: "In your external load balancer, what is the balancing algorithm used by API, Machine Configuration, and Ingress Controller?"
    - type: "survey"
      question: "How often is the load balancer configuration reviewed and updated?"
    - type: "survey"
      question: "Are there any known issues with the current load balancing setup?"
    - type: "survey"
      question: "Is there a backup mechanism for the load balancer configuration?"
  common_outcomes:
  - key: "nochange01"
    scenario_description_short_text: "Load Balancer configurado correctamente"
    description_long_text: "La API preparada para un algoritmo sin estado como Round Robin. El Ingress Controller esta configurado para persistencia basada en la conexión o basada en la sesión"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "Load Balancer no configurado correctamente"
    description_long_text: "La API no está configurada para un algoritmo sin estado como Round Robin. El Ingress Controller no está configurado para la persistencia basada en la conexión o basada en la sesión"
    impact_and_risk_text: "El tráfico que ingresa puede comportarse de manera inesperada"
    remediation_text: "Modificar la configuración del Load Balancer externa"
  - key: "notapplicable01"
    scenario_description_short_text: "No se esta utilizando un Load Balancer externo"
    description_long_text: "No se esta utilizando un Load Balancer externo"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "advisory01"
    scenario_description_short_text: "La configuración del Load Balancer está respaldada."
    description_long_text: "Existe un mecanismo de respaldo para la configuración del Load Balancer, lo que garantiza la recuperación de datos en caso de falla."
    impact_and_risk_text: ""
    remediation_text: "Continúe manteniendo copias de seguridad regulares de la configuración del Load Balancer."
  - key: "changes_recommended01"
    scenario_description_short_text: "La frecuencia de revisión del Load Balancer es insuficiente."
    description_long_text: "Las configuraciones del Load Balancer no se revisan con la frecuencia suficiente, lo que puede conducir a configuraciones obsoletas."
    impact_and_risk_text: "Las revisiones poco frecuentes pueden dar lugar a configuraciones erróneas y posibles problemas de red."
    remediation_text: "Aumente la frecuencia de las revisiones de configuración del Load Balancer para garantizar que permanezcan actuales y efectivos."
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""