version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Scheduling"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "Control Nodes Schedulable"
  references: 
  - title: "How to make control-plane schedulable during cluster installation in OCP 4"
    url: "https://access.redhat.com/solutions/4685721"
  - title: "Checking for control plane scheduling configuration"
    url: "https://docs.openshift.com/container-platform/latest/installing/installing_bare_metal_ipi/ipi-install-installation-workflow.html#configure-network-components-to-run-on-the-control-plane_ipi-install-installation-workflow"
  check_procedures:
    - type: survey
      question: "Is control plane schedulable?"
    - type: command 
      command: |
        # check master nodes for worker role
        oc get node
        oc get scheduler cluster -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "El plano de control no se puede programar (unschedulable)"
    description_long_text: "Los nodos del plano de control no se pueden programar; solo se ejecutarán en estos nodos las cargas de trabajo relacionadas con el plano de control"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "Control Plane is schedulable"
    description_long_text: "Control Plane noes are schedulable, workloads may run on these nodes."
    impact_and_risk_text: "Workloads may run on control plane nodes and may cause performance issues."
    remediation_text: "Make Control Plane nodes unschedulable"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc get node
