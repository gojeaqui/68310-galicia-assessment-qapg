version: v2
check_definition:
  category_key: "appdev"
  subcategory_key: "Resource Requests"
  severity_key: "Not defined"
  tags: []
  description: "Limit-Request Configured"
  references: 
  - title: "Restrict resource consumption with limit ranges"
    url: "https://docs.openshift.com/container-platform/latest/nodes/clusters/nodes-cluster-limit-ranges.html"
  - title: "Kubernetes Resource Recommendations Based on Historical Data"
    url: "https://github.com/robusta-dev/krr"
  check_procedures:
    - type: "command"
      command: |
        oc get pods -A -o custom-columns="NAMESPACE:.metadata.namespace,NAME:.metadata.name,CPU_REQUESTS:.spec.containers[*].resources.requests.cpu,CPU_LIMITS:.spec.containers[*].resources.limits.cpu,MEMORY_REQUESTS:.spec.containers[*].resources.requests.memory,MEMORY_LIMITS:.spec.containers[*].resources.limits.memory"
    - type: "survey"
      question: "What types of applications are in production? E.g. cronjobs, webapps, integrations"
    - type: "survey"
      question: "Are resource limits and requests configured for all critical applications?"
    - type: "survey"
      question: "How often are resource configurations reviewed and updated?"
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "Limits y Requests configurados"
    description_long_text: "Se han establecido Limits y Requests para todos los pods de aplicación"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "Limits y Requests no configurados"
    description_long_text: "No se han establecido Limits y Requests para todos los pods de aplicación"
    impact_and_risk_text: "Sin límites, las aplicaciones pueden consumir grandes cantidades de recursos informáticos"
    remediation_text: "Implementar Limits y Requests"
  - key: "advisory01"
    scenario_description_short_text: "Revisar las configuraciones de recursos"
    description_long_text: "Se recomienda revisar periódicamente las configuraciones de recursos para garantizar un rendimiento óptimo"
    impact_and_risk_text: ""
    remediation_text: "Programar revisiones periódicas de las configuraciones de recursos"
  - key: "no_change02"
    scenario_description_short_text: "Configuraciones de recursos actualizadas"
    description_long_text: "Las configuraciones de recursos se revisan y actualizan periódicamente"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "changes_recommended01"
    scenario_description_short_text: "Configuraciones de recursos obsoletas"
    description_long_text: "Las configuraciones de recursos no se han revisado recientemente"
    impact_and_risk_text: "Las configuraciones obsoletas pueden provocar un uso ineficiente de los recursos"
    remediation_text: "Revisar y actualizar las configuraciones de recursos"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc get pods -A -o custom-columns="NAME:.metadata.name,CPU_REQUESTS:.spec.containers[*].resources.requests.cpu,CPU_LIMITS:.spec.containers[*].resources.limits.cpu,MEMORY_REQUESTS:.spec.containers[*].resources.requests.memory,MEMORY_LIMITS:.spec.containers[*].resources.limits.memory"
