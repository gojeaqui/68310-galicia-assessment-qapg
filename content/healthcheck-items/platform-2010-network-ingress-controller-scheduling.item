version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "Ingress Controller Replica Count"
  references: 
  - title: "document replica count"
    url: "https://docs.openshift.com/container-platform/latest/networking/ingress-operator.html"
  check_procedures:
    - type: command
      command: |
        oc get ingresscontroller --all-namespaces -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "El Ingress Controller tiene alta disponibilidad"
    description_long_text: "Existe un mínimo de 3 Ingress Controller que permiten una alta disponibilidad."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "Incorrect number of replicas"
    description_long_text: "Only 1 IngressController exists, which may impact availability."
    impact_and_risk_text: "If the node the IngressController is running on becomes unavailable, the cluster may become unreachable.A minimum 3 is recommended"
    remediation_text: "Adjust replica count for Ingress Controller"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
