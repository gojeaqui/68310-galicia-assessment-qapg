version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "vSphere"
  severity_key: "Not defined"
  tags: []
  description: "Time / NTP checks"
  references: 
  - title: "Installing a cluster on vSphere"
    url: "https://docs.openshift.com/container-platform/latest/installing/installing_vsphere/ipi/ipi-vsphere-installation-reqs.html"
  - title: "Synchronize ESXi hosts with Network Time Server"
    url: "https://docs.vmware.com/en/VMware-vSphere/7.0/com.vmware.vsphere.vcenterhost.doc/GUID-8756D419-A878-4AE0-9183-C6D5A91A8FB1.html"
  check_procedures:
    - type: gui_action
      steps: 
      - "verify configuration at System > Time Configuration in vSphere Client"
    - type: "survey"
      question: "Inquire the client to validate that ESXi hosts times are synchronized with Network Time Protocol (NTP) server."
    - type: "survey"
      question: "What NTP servers are currently configured in the environment?"
    - type: "survey"
      question: "Is there a backup NTP server configured for redundancy?"
    - type: "survey"
      question: "What is the current time drift tolerance configured for the hosts?"
    - type: "survey"
      question: "Are all ESXi hosts in the same timezone configuration?"
    - type: "survey"
      question: "How frequently are NTP sync checks performed?"
    - type: "survey"
      question: "Have there been any recent time synchronization issues reported?"
  common_outcomes:
  - key: "advisory01"
    scenario_description_short_text: "Se requiere revisión de configuración de NTP"
    description_long_text: "Revisión actual de necesidades de configuración de NTP para redundancia y confiabilidad"
    impact_and_risk_text: "Posible punto de falla único en la sincronización de tiempo."
    remediation_text: "Configurar servidores NTP secundarios e implementar el monitoreo"
  - key: "advisory02"
    scenario_description_short_text: "Se requiere supervisión de desviación de tiempo (Time Drift)."
    description_long_text: "La supervisión de la desviación de tiempo no está configurada correctamente."
    impact_and_risk_text: "Riesgo de problemas de sincronización de tiempo no detectados"
    remediation_text: "Implementar el monitoreo y la alerta de la desviación del tiempo"
  - key: "no_change01"
    scenario_description_short_text: "Sincronización de tiempo habilitada y sincronizada"
    description_long_text: "La sincronización de tiempo en los hosts ESXi está habilitada y sincronizada con un servidor NTP (Network Time Protocol)."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "no_change02"
    scenario_description_short_text: "Configuración óptima de NTP"
    description_long_text: "La configuración de NTP sigue las mejores prácticas y cuenta con redundancia."
    impact_and_risk_text: "Perfil de bajo riesgo para la sincronización del tiempo"
    remediation_text: "Mantener la configuración actual"
  - key: "changes_required01"
    scenario_description_short_text: "Sincronización de tiempo deshabilitado"
    description_long_text: "La sincronización de tiempo en los hosts ESXi está deshabilitada. El cliente debe tomar medidas para habilitar la sincronización y así evitar problemas de sincronización con etcd."
    impact_and_risk_text: "La configuración de tiempo en los hosts ESXi no está establecida. Esto representa un riesgo de fallo del clúster debido a la falta de sincronización de tiempo en la red en los hosts ESXi."
    remediation_text: "Configurar el tiempo del sistema ESXi con el servidor de Network Time Protocol (NTP)."
  - key: "changes_recommended01"
    scenario_description_short_text: "Sincronización de tiempo manual"
    description_long_text: "El tiempo de los hosts ESXi se sincroniza manualmente. Se recomienda utilizar una fuente de tiempo centralizada en la red."
    impact_and_risk_text: "La configuración de tiempo en los hosts ESXi es manual, lo representa un riesgo de fallo del clúster debido a la falta de sincronización de tiempo a traves de la red."
    remediation_text: "Configure la hora del sistema ESXi con un servidor de Network Time Protocol (NTP)."
  - key: "changes_recommended02"
    scenario_description_short_text: "Inconsistencia de la zona horaria"
    description_long_text: "Diferentes configuraciones de zona horaria en los hosts ESXi"
    impact_and_risk_text: "Riesgo de inconsistencia de operaciones basadas en el tiempo"
    remediation_text: "Estandarizar la configuración de la zona horaria en todos los hosts"
  - key: "not_applicable"
    scenario_description_short_text: ""
    description_long_text: ""
    description_long_text: ""
    impact_and_risk_text: ""
    impact_and_risk_text: ""
    remediation_text: ""
    remediation_text: ""
customer_environment_findings:
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""