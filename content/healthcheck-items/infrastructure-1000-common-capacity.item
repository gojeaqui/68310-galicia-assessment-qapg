version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "Common"
  tag_keys: []
  severity_key: "Not defined"
  tags: []
  description: "OpenShift Node CPU/Memory/Storage"
  references: 
  - title: "Minimum Resource requirements for Cluster Operation"
    url: "https://docs.openshift.com/container-platform/latest/installing/installing_platform_agnostic/installing-platform-agnostic.html"
  check_procedures:
    - type: "survey"
      question: "How much CPU, Memory, and Local Storage are assigned to each node? Obtain information either at the infrastructure/cloud provider layer or from within the platform."
    - type: "survey"
      question: "Are there any nodes currently experiencing resource pressure or constraints?"
    - type: "survey"
      question: "What monitoring tools are used to track node resource usage over time?"
    - type: "command"
      command: |
          oc get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.capacity.cpu}{"\t"}{.status.capacity.memory}{"\t"}{.status.capacity.ephemeral-storage}{"\n"}{end}'
          oc get machinesets -n openshift-machine-api
  common_outcomes:
  - key: "scenario1"
    scenario_description_short_text: "Requisitos cumplidos"
    description_long_text: "Todos los nodos cumplen con los requisitos mínimos y actualmente hay una cantidad adecuada para gestionar las cargas de trabajo implementadas en el clúster"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "scenario2"
    scenario_description_short_text: "Nodos de Infra con disco de 100Gi"
    description_long_text: "Se observa en el listado de capacidad de nodos que los nodos de Infra tienen un disco de 100 Gi."
    impact_and_risk_text: "Un tamaño de disco de 100Gi esta en el limite de lo recomendado y puede ocasionar problemas en los nodos."
    remediation_text: "Se recomienda regenerar los MachineSet de infra con un tamaño de disco de 120Gi al menos"
  - key: "advisory01"
    scenario_description_short_text: "Mejores prácticas para la monitorización de recursos"
    description_long_text: "Asegure la monitorización y el análisis continuos del uso de recursos de los nodos"
    impact_and_risk_text: "Ayuda a la gestión proactiva de recursos y a evitar posibles cuellos de botella"
    remediation_text: "Implemente soluciones de monitorización para rastrear y analizar las tendencias de uso de recursos de los nodos"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: changes_recommended
  common_outcome_key: "scenario2"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
