version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "EmptyDir Volumes"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Storage"
  description: "EmptyDir Volumes in use"
  references: 
  - title: "Understanding ephemeral storage"
    url: "https://docs.openshift.com/container-platform/latest/storage/understanding-ephemeral-storage.html"
  check_procedures:
    - type: command
      command: | 
        oc get pods -A -o custom-columns=NAMESPACE:.metadata.namespace,NAME:.metadata.name,VOLUME:.spec.volumes | grep empty 
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "EmptyDir volumes not in use"
    description_long_text: "Workloads requiring storage have dedicated volumes, projects do not rely on EmptyDir"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "Se están utilizando volúmenes de tipo EmptyDir pero no hay afectación"
    description_long_text: "Algunas cargas de trabajo utilizan almacenamiento efímero, pero a su vez sabemos que los datos se persisten en PVCs."
    impact_and_risk_text: "No se puede garantizar el almacenamiento para las cargas de trabajo que utilizan EmptyDirs; se trata de un recurso de mejor esfuerzo que podría provocar la expulsión de pods."
    remediation_text: ""
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc get pods -A -o custom-columns=NAME:.metadata.name,NAMESPACE:.metadata.namespace,VOLUME:.spec.volumes | grep empty
