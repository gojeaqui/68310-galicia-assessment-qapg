version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  description: "Ingress Controller type"
  tag_keys:
    - "Openshift Cluster Configuration"
  references: 
  - title: "Ingress Controller type"
    url: "https://docs.openshift.com/container-platform/latest/networking/ingress-operator.html"
  - title: "Configuring Ingress Cluster Traffic"
    url: "https://docs.openshift.com/container-platform/latest/networking/configuring_ingress_cluster_traffic/overview-traffic.html"
  check_procedures:
    - type: command
      command: | 
        oc get ingressclass
        oc describe ingresscontroller -n openshift-ingress-operator default
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Solo hay un Ingress Controller"
      description_long_text: ""  # Consultant to fill out custom ingress controller type, if any
      impact_and_risk_text: ""
      remediation_text: ""
