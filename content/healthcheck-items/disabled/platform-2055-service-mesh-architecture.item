version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Service Mesh"
  severity_key: "Not defined"
  tags: []
  description: "Service Mesh Architecture & Usage"
  references: 
  - title: "OpenShift Service Mesh Architecture"
    url: "https://docs.openshift.com/container-platform/latest/service_mesh/v2x/ossm-architecture.html"
  - title: "Preparing to install Red Hat OpenShift Service Mesh"
    url: "https://docs.openshift.com/container-platform/latest/service_mesh/v2x/preparing-ossm-installation.html"
  - title: "Adding Projects to Service Mesh"
    url: "https://docs.openshift.com/container-platform/latest/service_mesh/v2x/ossm-create-mesh.html"
  check_procedures:
    - type: "survey"
      question: "Do you have service mesh installed?"     
    - type: "survey"
      question: "What is your service mesh architecture?"
    - type: "survey"
      question: "How many service meshes are there?"  
    - type: "survey"
      question: "Is everyone using it?" 
    - type: "survey"
      question: "How is service mesh managed? IaC?" 
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Information Only"
      description_long_text: ""  # Consultant to describe service mesh implementation
      impact_and_risk_text: ""
      remediation_text: ""
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
