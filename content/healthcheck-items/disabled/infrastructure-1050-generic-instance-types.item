version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "generic"
  severity_key: "Not defined"
  tags: []
  description: "Cloud Native Integrations"
  tag_keys:
    - "Azure"
    - "AWS"
  references: 
    - title: "Recommended host practices"
      url: "https://docs.openshift.com/container-platform/latest/scalability_and_performance/recommended-host-practices.html"
  check_procedures:
    - type: "survey"
      question: "Document Instance Types."
    - type: "survey"
      question: "What instance types are currently used for control plane nodes?"
    - type: "survey"
      question: "What instance types are used for worker nodes?"
    - type: "survey"
      question: "Are there any specialized workloads requiring specific instance types?"
    - type: "survey"
      question: "How is instance type selection aligned with workload requirements?"
    - type: "survey"
      question: "What is the CPU and memory ratio across instance types?"
    - type: "survey"
      question: "Are there any cost optimization considerations for instance types?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Instance Type Review"
      description_long_text: "Current instance types need evaluation for optimization"
      impact_and_risk_text: "Potential resource inefficiency or cost implications"
      remediation_text: "Review and optimize instance type selection"
    - key: "advisory02"
      scenario_description_short_text: "Mixed Instance Strategy"
      description_long_text: "Various instance types in use across cluster"
      impact_and_risk_text: "Complex management and potential inconsistency"
      remediation_text: "Standardize instance types where possible"
    - key: "no_change01"
      scenario_description_short_text: "Optimal Instance Configuration"
      description_long_text: "Instance types well-aligned with workload requirements"
      impact_and_risk_text: "Efficient resource utilization"
      remediation_text: "Continue monitoring workload requirements"
    - key: "no_change02"
      scenario_description_short_text: "Cost-Effective Selection"
      description_long_text: "Instance types balanced for performance and cost"
      impact_and_risk_text: "Good resource efficiency and cost management"
      remediation_text: "Maintain current instance strategy"
    - key: "changes_recommended01"
      scenario_description_short_text: "Instance Rightsizing Required"
      description_long_text: "Current instance types not optimal for workload"
      impact_and_risk_text: "Resource waste or performance constraints"
      remediation_text: "Implement recommended instance types"
    - key: "changes_recommended02"
      scenario_description_short_text: "Performance Optimization Needed"
      description_long_text: "Instance types limiting application performance"
      impact_and_risk_text: "Suboptimal application performance"
      remediation_text: "Upgrade to recommended instance types"
customer_environment_findings:
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
