version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "vSphere"
  severity_key: "Not defined"
  tag_keys:
    - "Disaster Recovery"
    - "High Availability" 
  tags: []
  description: "VMware vCenter Highly Available"
  references: 
  - title: "vCenter HA Cluster Configuration"
    url: "https://docs.vmware.com/en/VMware-vSphere/7.0/com.vmware.vsphere.avail.doc/GUID-8BDD82D8-B6BF-4C1B-9E3F-6395CC2FAFD5.html"
  - title: "vCenter High Availability"
    url: "https://docs.vmware.com/en/VMware-vSphere/7.0/com.vmware.vsphere.avail.doc/GUID-4A626993-A829-495C-9659-F64BA8B560BD.html"
  - title: "Protecting vCenter Server with vCenter High Availability"
    url: "https://docs.vmware.com/en/VMware-vSphere/7.0/com.vmware.vsphere.avail.doc/GUID-226A925F-BF20-4A58-BF15-4A76B4CEDC84.html"
  check_procedures:
    - type: "survey"
      question: "Please have the client provide information if their VMware vCenter server architecture is currently configured for high availability."
    - type: "survey"
      question: "What is the current vCenter HA topology (Active-Passive, Active-Active)?"
    - type: "survey"
      question: "What is the configured failover time for vCenter HA?"
    - type: "survey"
      question: "Are there any custom scripts or automations dependent on vCenter availability?"
    - type: "survey"
      question: "How frequently are vCenter HA failover tests performed?"
    - type: "survey"
      question: "What monitoring solutions are in place for vCenter HA health?"
    - type: "survey"
      question: "Is there a documented failover procedure for vCenter HA?"
  common_outcomes:
  - key: "advisory01"
    scenario_description_short_text: "Se necesita revisión de la configuración de HA"
    description_long_text: "La configuración de vCenter HA requiere revisión para un rendimiento óptimo"
    impact_and_risk_text: "Posibles brechas en cobertura de alta disponibilidad"
    remediation_text: "Revisar y optimizar los parámetros de configuración de HA"
  - key: "advisory02"
    scenario_description_short_text: "Se requiere un programa de pruebas de HA"
    description_long_text: "Pruebas regulares de conmutación por error de HA no implementadas"
    impact_and_risk_text: "Confiabilidad desconocida del mecanismo de conmutación por error"
    remediation_text: "Implementar un cronograma regular de pruebas de HA"
  - key: "no_change01"
    scenario_description_short_text: "Configuración de HA óptima"
    description_long_text: "vCenter Server high availability is configured as referenced in VMware's documentation."
    description_long_text: "La alta disponibilidad de vCenter Server está configurada según lo indicado en la documentación de VMware."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "no_change02"
    scenario_description_short_text: "Pruebas de HA validadas"
    description_long_text: "Las pruebas de HA regulares confirman una conmutación por error confiable"
    impact_and_risk_text: "Riesgo mínimo de tiempo de inactividad extendido"
    remediation_text: "Continuar el cronograma de pruebas actuales"
  - key: "changes_recommended01"
    scenario_description_short_text: "vCenter HA no configurado"
    description_long_text: "La alta disponibilidad de vCenter Server no está configurada."
    impact_and_risk_text: "Cuando la API del servidor vCenter no está disponible, esto puede degradar la capacidad de los administradores de clúster y OpenShift para controlar completamente su infraestructura."
    remediation_text: "El cliente debe considerar configurar el servidor de vCenter para asegurarse de que esté altamente disponible en caso de falla del servidor."
  - key: "changes_recommended02"
    scenario_description_short_text: "Se requieren mejoras en la supervisión de alta disponibilidad (HA)."
    description_long_text: "El monitoreo actual del estado de HA es insuficiente"
    impact_and_risk_text: "Riesgo de problemas de HA no detectados"
    remediation_text: "Implementar una solución integral de monitoreo de HA"
customer_environment_findings:
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
