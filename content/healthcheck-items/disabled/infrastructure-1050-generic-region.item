version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "generic"
  severity_key: "Not defined"
  tags: []
  description: "Cloud Region"
  tag_keys:
    - "Azure"
    - "AWS"
  references: 
    - title: "Supported regions for cloud platforms"
      url: "https://docs.openshift.com/container-platform/latest/installing/installing_platform_agnostic/installing-platform-agnostic.html"
  check_procedures:
    - type: "survey"
      question: "Document Regions."
    - type: "survey"
      question: "Which cloud regions are currently in use?"
    - type: "survey"
      question: "Are there any secondary regions for disaster recovery?"
    - type: "survey"
      question: "What is the latency between regions being used?"
    - type: "survey"
      question: "How are workloads distributed across regions?"
    - type: "survey"
      question: "What is the data replication strategy between regions?"
    - type: "survey"
      question: "Are there any regulatory requirements for region selection?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Region Strategy Review"
      description_long_text: "Current regional deployment needs assessment"
      impact_and_risk_text: "Potential geographic redundancy gaps"
      remediation_text: "Review and optimize regional strategy"
    - key: "advisory02"
      scenario_description_short_text: "Latency Consideration"
      description_long_text: "Inter-region latency impact assessment needed"
      impact_and_risk_text: "Performance impact on cross-region operations"
      remediation_text: "Evaluate and optimize cross-region communication"
    - key: "no_change01"
      scenario_description_short_text: "Optimal Regional Setup"
      description_long_text: "Regional configuration meets all requirements"
      impact_and_risk_text: "Low risk profile with good geographic distribution"
      remediation_text: "Maintain current regional configuration"
    - key: "no_change02"
      scenario_description_short_text: "Compliant Region Usage"
      description_long_text: "Regions selected meet regulatory requirements"
      impact_and_risk_text: "Compliance requirements satisfied"
      remediation_text: "Continue monitoring regulatory requirements"
    - key: "changes_recommended01"
      scenario_description_short_text: "Additional Region Required"
      description_long_text: "Single region deployment identified"
      impact_and_risk_text: "Risk of regional failure impact"
      remediation_text: "Implement multi-region strategy"
    - key: "changes_recommended02"
      scenario_description_short_text: "Region Optimization Needed"
      description_long_text: "Current region selection not optimal for workload"
      impact_and_risk_text: "Performance and cost implications"
      remediation_text: "Optimize region selection based on requirements"
