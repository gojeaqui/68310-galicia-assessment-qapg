      remediation_text: ""
    - key: "advisory02"
      scenario_description_short_text: "AMI Documentation Needed"
      description_long_text: "AMI management process lacks documentation"
      impact_and_risk_text: "Risk of inconsistent AMI management"
      remediation_text: "Document AMI lifecycle management procedures"
    - key: "no_change01"
      scenario_description_short_text: "Optimal AMI Management"
      description_long_text: "AMIs properly managed and updated regularly"
      impact_and_risk_text: "Low risk profile with current AMI strategy"
      remediation_text: "Maintain current AMI management process"
    - key: "changes_recommended01"
      scenario_description_short_text: "AMI Update Required"
      description_long_text: "Outdated AMIs identified in use"
      impact_and_risk_text: "Security and performance risks from outdated images"
      remediation_text: "Update to latest validated AMIs"
    - key: "changes_recommended02"
      scenario_description_short_text: "AMI Standardization Needed"
      description_long_text: "Multiple AMI versions in use across similar workloads"
      impact_and_risk_text: "Complex management and potential inconsistencies"
      remediation_text: "Standardize AMI usage across workload types"
