version: v2
check_definition:
  category_key: "appdev"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Infrastructure"
    - "OpenShift Cluster"
    - "Configuration"
  description: "Cross-site networking"
  references:
    - title: "Cluster Networking"
      url: "https://docs.openshift.com/container-platform/latest/networking/understanding-networking.html"
  check_procedures:
    - type: survey
      question: "What are the cross-site networking requirements?"
    - type: survey
      question: "How is network traffic monitored across sites?"
    - type: survey
      question: "What tools are used for managing cross-site network configurations?"
    - type: survey
      question: "Are there any challenges in maintaining network security across sites?"
    - type: survey
      question: "How often are cross-site network configurations reviewed and updated?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Information Only"
      description_long_text: ""  # Consultant to describe cross-site networking strategy.
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended01"
      scenario_description_short_text: "Revisiones de red poco frecuentes"
      description_long_text: "Las configuraciones de red entre sitios no se revisan periódicamente."
      impact_and_risk_text: "Las revisiones poco frecuentes pueden dar lugar a prácticas obsoletas y posibles riesgos de seguridad."
      remediation_text: "Establecer un programa regular para revisar y actualizar las configuraciones de red entre sitios."
    - key: "advisory02"
      scenario_description_short_text: "Revisar las herramientas de gestión de red"
      description_long_text: "Se recomienda revisar periódicamente las herramientas de gestión de red para garantizar que satisfagan las necesidades actuales."
      impact_and_risk_text: ""
      remediation_text: "Evaluar las herramientas actuales y explorar nuevas opciones si es necesario."
    - key: "no_change01"
      scenario_description_short_text: "Gestión de red adecuada"
      description_long_text: "Las prácticas actuales de gestión de red son suficientes"
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended02"
      scenario_description_short_text: "Desafíos en la seguridad de la red"
      description_long_text: "Existen desafíos para mantener la seguridad de la red en todos los sitios."
      impact_and_risk_text: "Una gestión inadecuada de la seguridad de la red puede generar vulnerabilidades."
      remediation_text: "Implementar las mejores prácticas de seguridad de la red y garantizar la implementación de controles de acceso adecuados."
