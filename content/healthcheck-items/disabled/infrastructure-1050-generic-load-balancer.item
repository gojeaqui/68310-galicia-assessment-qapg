version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "generic"
  severity_key: "Not defined"
  tags: []
  description: "Load Balancer Configuration"
  tag_keys:
    - "Azure"
    - "AWS"
  references: 
    - title: "Configuring load balancers"
      url: "https://docs.openshift.com/container-platform/latest/networking/configuring_load_balancer.html"
  check_procedures:
    - type: "survey"
      question: "Document Load Balancer Configuration."
    - type: "survey"
      question: "What type of load balancer is currently implemented?"
    - type: "survey"
      question: "How is the load balancer handling ingress traffic?"
    - type: "survey"
      question: "What health checks are configured for the load balancer?"
    - type: "survey"
      question: "Is SSL termination configured at the load balancer level?"
    - type: "survey"
      question: "What is the current load balancer failover configuration?"
    - type: "survey"
      question: "Are there any custom routing rules implemented?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Load Balancer Review Required"
      description_long_text: "Current load balancer configuration needs assessment"
      impact_and_risk_text: "Potential performance and reliability concerns"
      remediation_text: "Review and optimize load balancer settings"
    - key: "advisory02"
      scenario_description_short_text: "Health Check Configuration"
      description_long_text: "Load balancer health checks need enhancement"
      impact_and_risk_text: "Risk of routing traffic to unhealthy endpoints"
      remediation_text: "Implement comprehensive health check strategy"
    - key: "no_change01"
      scenario_description_short_text: "Optimal Configuration"
      description_long_text: "Load balancer properly configured with redundancy"
      impact_and_risk_text: "Low risk profile for traffic distribution"
      remediation_text: "Maintain current configuration"
    - key: "no_change02"
      scenario_description_short_text: "SSL Properly Configured"
      description_long_text: "SSL termination and security properly implemented"
      impact_and_risk_text: "Secure traffic handling in place"
      remediation_text: "Continue monitoring SSL certificate lifecycle"
    - key: "changes_recommended01"
      scenario_description_short_text: "Load Balancer Upgrade Required"
      description_long_text: "Current load balancer solution inadequate for workload"
      impact_and_risk_text: "Performance bottlenecks and reliability issues"
      remediation_text: "Upgrade to enterprise-grade load balancer solution"
    - key: "changes_recommended02"
      scenario_description_short_text: "Failover Implementation Needed"
      description_long_text: "Load balancer failover not properly configured"
      impact_and_risk_text: "Risk of service disruption during failures"
      remediation_text: "Implement proper failover configuration"
customer_environment_findings:
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""