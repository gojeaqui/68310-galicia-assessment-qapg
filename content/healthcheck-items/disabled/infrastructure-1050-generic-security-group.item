version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "generic"
  severity_key: "Not defined"
  tags: []
  description: "Security Groups Configuration"
  tag_keys:
    - "Azure"
    - "AWS"
  references: 
    - title: "Configuring network security"
      url: "https://docs.openshift.com/container-platform/latest/networking/network_policy/about-network-policy.html"
  check_procedures:
    - type: "survey"
      question: "Review Security Groups Configuration."
    - type: "survey"
      question: "What security groups are currently implemented?"
    - type: "survey"
      question: "How are inbound and outbound rules configured?"
    - type: "survey"
      question: "Are there any custom security group rules?"
    - type: "survey"
      question: "How are security groups organized across different environments?"
    - type: "survey"
      question: "What is the process for security group changes?"
    - type: "survey"
      question: "How are security groups monitored for compliance?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Security Group Review Required"
      description_long_text: "Current security group configuration needs assessment"
      impact_and_risk_text: "Potential security gaps in network access"
      remediation_text: "Review and optimize security group rules"
    - key: "advisory02"
      scenario_description_short_text: "Rule Documentation Needed"
      description_long_text: "Security group rules lack proper documentation"
      impact_and_risk_text: "Risk of misconfigurations during changes"
      remediation_text: "Document all security group rules and their purpose"
    - key: "no_change01"
      scenario_description_short_text: "Optimal Security Configuration"
      description_long_text: "Security groups properly configured and documented"
      impact_and_risk_text: "Low risk profile with proper access controls"
      remediation_text: "Maintain current security configuration"
    - key: "no_change02"
      scenario_description_short_text: "Compliant Rule Set"
      description_long_text: "Security group rules meet compliance requirements"
      impact_and_risk_text: "Security compliance maintained"
      remediation_text: "Continue monitoring compliance requirements"
    - key: "changes_recommended01"
      scenario_description_short_text: "Security Rules Tightening Required"
      description_long_text: "Overly permissive security group rules identified"
      impact_and_risk_text: "Increased attack surface and security risks"
      remediation_text: "Implement least privilege access rules"
    - key: "changes_recommended02"
      scenario_description_short_text: "Rule Standardization Needed"
      description_long_text: "Inconsistent security group configurations"
      impact_and_risk_text: "Complex management and potential security gaps"
      remediation_text: "Standardize security group configurations"
