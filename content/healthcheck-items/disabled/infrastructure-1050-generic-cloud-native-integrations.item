version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "generic"
  severity_key: "Not defined"
  tags: []
  description: "Cloud Native Integrations"
  tag_keys:
    - "Azure"
    - "AWS"
  references: 
    - title: "Cloud Provider Integration"
      url: "https://docs.openshift.com/container-platform/latest/installing/installing_platform_agnostic/installing-platform-agnostic.html"
  check_procedures:
    - type: "survey"
      question: "Document Cloud Native Integrations."
    - type: "survey"
      question: "What cloud provider services are currently integrated with the cluster?"
    - type: "survey"
      question: "How is cloud storage being utilized in the environment?"
    - type: "survey"
      question: "What cloud-native load balancing solutions are implemented?"
    - type: "survey"
      question: "Are cloud provider's IAM services integrated with the cluster?"
    - type: "survey"
      question: "What cloud monitoring and logging services are being used?"
    - type: "survey"
      question: "How is auto-scaling configured with cloud provider resources?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Limited Cloud Integration"
      description_long_text: "Minimal use of cloud-native services"
      impact_and_risk_text: "Not leveraging full cloud provider capabilities"
      remediation_text: "Evaluate additional cloud service integration opportunities"
    - key: "advisory02"
      scenario_description_short_text: "Integration Review Required"
      description_long_text: "Current cloud integrations need assessment"
      impact_and_risk_text: "Potential inefficiencies in resource usage"
      remediation_text: "Review and optimize cloud service integration"
    - key: "no_change01"
      scenario_description_short_text: "Optimal Cloud Integration"
      description_long_text: "Effective use of cloud-native services"
      impact_and_risk_text: "Low risk profile with good service utilization"
      remediation_text: "Maintain current integration strategy"
    - key: "no_change02"
      scenario_description_short_text: "Cloud Services Well Utilized"
      description_long_text: "Comprehensive cloud service integration implemented"
      impact_and_risk_text: "Efficient use of cloud provider capabilities"
      remediation_text: "Continue monitoring service usage and costs"
    - key: "changes_recommended01"
      scenario_description_short_text: "Integration Gaps Identified"
      description_long_text: "Missing critical cloud service integrations"
      impact_and_risk_text: "Reduced efficiency and higher operational overhead"
      remediation_text: "Implement recommended cloud service integrations"
    - key: "changes_recommended02"
      scenario_description_short_text: "Security Integration Required"
      description_long_text: "Cloud security services not fully utilized"
      impact_and_risk_text: "Potential security gaps in cloud resource access"
      remediation_text: "Implement cloud security service integration"
customer_environment_findings:
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""