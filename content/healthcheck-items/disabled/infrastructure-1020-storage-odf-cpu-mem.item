version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "storage"
  severity_key: "Not defined"
  tags: []
  description: "ODF CPU/Memory Check"
  references:
  - title: "Red Hat OpenShift Data Foundation"
    url: "https://docs.openshift.com/container-platform/latest/storage/persistent_storage/persistent-storage-ocs.html"
  check_procedures:
    - type: survey
      question: "Asegurarse de que la asignación de recursos (CPU/memoria) a los pods de ODF sea apropiada y no cause cuellos de botella."
    - type: "command"
      command: |
        oc describe node | awk '/Name:/{node=$2} /openshift-storage/ && /%/{gsub(/[()]/,""); print node, $0}' | column -t
        oc adm top pods -n openshift-storage
        oc get nodes -l cluster.ocs.openshift.io/openshift-storage='' -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.capacity.cpu}{"\t"}{.status.capacity.memory}{"\t"}{.status.capacity.ephemeral-storage}{"\n"}{end}'
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "ODF configurado apropiadamente"
      description_long_text: "ODF está instalado y configurado correctamente con capacidad de almacenamiento y redundancia adecuados"
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "no_change01"
      scenario_description_short_text: "La asignación de recursos (CPU/memoria) a los pods de ODF es apropiada"
      description_long_text: "Encontramos que los recursos de CPU y Memoria asignados a los pods de ODF no supera la capacidad de los nodos de ODF y se corresponde con el uso normal de ODF"
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended01"
      scenario_description_short_text: "ODF necesita actualización"
      description_long_text: "La versión actual de ODF requiere una actualización para abordar los problemas conocidos o recibir nuevas funciones"
      impact_and_risk_text: "Ejecutar versiones desactualizadas puede hacer que falten correcciones o funciones importantes."
      remediation_text: "Actualizar ODF a la última versión compatible"
    - key: "changes_recommended02"
      scenario_description_short_text: "Revisión de configuración de ODF necesaria"
      description_long_text: "La configuración de ODF requiere una revisión para un rendimiento y confiabilidad óptimos"
      impact_and_risk_text: "La configuración subóptima puede afectar el rendimiento del almacenamiento"
      remediation_text: "Revise y optimice la configuración de ODF de acuerdo con las mejores prácticas"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc describe node | awk '/Name:/{node=$2} /openshift-storage/ && /%/{gsub(/[()]/,""); print node, $0}' | column -t
