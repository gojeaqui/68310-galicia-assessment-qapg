version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  description: "Load Balancer Type"
  references: []
  check_procedures:
    - type: survey
      question: "What external load balancer is in use (e.g. F5 or NetScaler)?"
    - type: survey
      question: "How is the load balancer configured in terms of redundancy and failover?"
    - type: survey
      question: "Are there any custom configurations applied to the load balancer?"
    - type: survey
      question: "How often is the load balancer configuration reviewed and updated?"
  common_outcomes:
  - key: "advisory01"
    scenario_description_short_text: "Information Only"
    description_long_text: ""  # Consultant to fill out load balancer type
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "advisory02"
    scenario_description_short_text: "La configuración del Load Balancer está actualizada."
    description_long_text: "La configuración del Load Balancer esta actualizada y sigue las mejores prácticas para la redundancia y la conmutación por error."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "no_change01"
    scenario_description_short_text: "La redundancia está configurada correctamente."
    description_long_text: "El Load Balancer tiene mecanismos de redundancia y conmutación por error, minimizando los riesgos de tiempo de inactividad."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "changes_recommended01"
    scenario_description_short_text: "Las configuraciones personalizadas necesitan revisión."
    description_long_text: "Las configuraciones personalizadas en el Load Balancer pueden conducir a un comportamiento inesperado y deben revisarse."
    impact_and_risk_text: "Las configuraciones personalizadas no revisadas pueden causar problemas de red."
    remediation_text: "Revise y documente todas las configuraciones personalizadas aplicadas al Load Balancer."
