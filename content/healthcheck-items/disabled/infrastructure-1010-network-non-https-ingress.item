    - "OpenShift Cluster Configuration"
  description: "Non-HTTP/HTTPS ingress connections"
  references: []
  check_procedures:
    - type: "command"
      command: |
        oc get routes --all-namespaces -o custom-columns='NAMESPACE:.metadata.namespace,NAME:.metadata.name,HOST:.spec.host,HTTPS:.spec.tls.termination'
    - type: survey
      question: "Describe non HTTP/HTTPS ingress connections"
    - type: survey
      question: "What protocols are used for non-HTTP/HTTPS ingress connections?"
    - type: survey
      question: "How are non-HTTP/HTTPS ingress connections secured?"
    - type: survey
      question: "Are there any known issues with non-HTTP/HTTPS ingress connections?"
