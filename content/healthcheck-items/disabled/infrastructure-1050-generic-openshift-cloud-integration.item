version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "generic"
  severity_key: "Not defined"
  tags: []
  description: "Cloud Integration"
  tag_keys:
    - "Azure"
    - "AWS"
  references: 
    - title: "Configuring cloud provider integrations"
      url: "https://docs.openshift.com/container-platform/latest/post_installation_configuration/cluster-tasks.html#available-cluster-customizations"
  check_procedures:
    - type: "survey"
      question: "Inquire the client is using cloud integration with OpenShift."
    - type: "survey"
      question: "Which cloud provider services are integrated with the cluster?"
    - type: "survey"
      question: "How is authentication configured with cloud services?"
    - type: "survey"
      question: "What cloud storage classes are configured and in use?"
    - type: "survey"
      question: "Are cloud-specific operators installed and configured?"
    - type: "survey"
      question: "How is cloud-based monitoring implemented?"
    - type: "survey"
      question: "What disaster recovery solutions are integrated with cloud services?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Cloud Integration Review Needed"
      description_long_text: "Current cloud integration requires assessment"
      impact_and_risk_text: "Potential missed opportunities for cloud service utilization"
      remediation_text: "Review and optimize cloud service integration"
    - key: "advisory02"
      scenario_description_short_text: "Authentication Review Required"
      description_long_text: "Cloud service authentication needs evaluation"
      impact_and_risk_text: "Potential security and access control gaps"
      remediation_text: "Review and enhance cloud authentication configuration"
    - key: "no_change01"
      scenario_description_short_text: "Optimal Cloud Integration"
      description_long_text: "Cloud services properly integrated and utilized"
      impact_and_risk_text: "Low risk profile with efficient cloud usage"
      remediation_text: "Continue monitoring cloud service utilization"
    - key: "no_change02"
      scenario_description_short_text: "Cloud Security Well Configured"
      description_long_text: "Cloud security and access controls properly implemented"
      impact_and_risk_text: "Secure cloud resource access in place"
      remediation_text: "Maintain current security configuration"
    - key: "changes_recommended01"
      scenario_description_short_text: "Limited Cloud Integration"
      description_long_text: "Insufficient use of available cloud services"
      impact_and_risk_text: "Missing benefits of cloud-native features"
      remediation_text: "Implement recommended cloud service integrations"
    - key: "changes_recommended02"
      scenario_description_short_text: "Cloud Monitoring Enhancement"
      description_long_text: "Cloud-based monitoring needs improvement"
      impact_and_risk_text: "Limited visibility into cloud resource usage"
      remediation_text: "Implement comprehensive cloud monitoring solution"
