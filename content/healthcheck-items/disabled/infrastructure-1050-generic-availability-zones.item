version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "generic"
  severity_key: "Not defined"
  tags: []
  description: "Availability Zones"
  tag_keys:
    - "Azure"
    - "AWS"
  references: 
    - title: "Understanding Availability Zones"
      url: "https://docs.openshift.com/container-platform/latest/installing/installing_platform_agnostic/installing-platform-agnostic.html#installation-requirements-user-infra_installing-platform-agnostic"
  check_procedures:
    - type: "survey"
      question: "Document Availability Zones Utilized."
    - type: "survey"
      question: "How many availability zones are currently in use?"
    - type: "survey"
      question: "How are workloads distributed across availability zones?"
    - type: "survey"
      question: "What is the failover strategy between availability zones?"
    - type: "survey"
      question: "Are there any workloads that require specific zone placement?"
    - type: "survey"
      question: "How is storage configured across availability zones?"
    - type: "survey"
      question: "What monitoring is in place for zone health and availability?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Single AZ Usage"
      description_long_text: "Environment running in single availability zone"
      impact_and_risk_text: "Increased risk of service disruption during zone failures"
      remediation_text: "Consider multi-AZ deployment for high availability"
    - key: "advisory02"
      scenario_description_short_text: "AZ Distribution Review"
      description_long_text: "Workload distribution across AZs needs optimization"
      impact_and_risk_text: "Potential resource imbalance between zones"
      remediation_text: "Review and adjust workload distribution strategy"
    - key: "no_change01"
      scenario_description_short_text: "Optimal AZ Configuration"
      description_long_text: "Proper utilization of multiple availability zones"
      impact_and_risk_text: "Low risk of complete service disruption"
      remediation_text: "Continue current AZ strategy"
    - key: "no_change02"
      scenario_description_short_text: "Balanced AZ Usage"
      description_long_text: "Workloads properly distributed across zones"
      impact_and_risk_text: "Minimal impact from single zone failure"
      remediation_text: "Maintain current configuration"
    - key: "changes_recommended01"
      scenario_description_short_text: "AZ Redundancy Required"
      description_long_text: "Insufficient availability zone redundancy"
      impact_and_risk_text: "High risk of service disruption during outages"
      remediation_text: "Implement multi-AZ architecture"
    - key: "changes_recommended02"
      scenario_description_short_text: "AZ Monitoring Improvement"
      description_long_text: "Insufficient monitoring of AZ health and status"
      impact_and_risk_text: "Risk of delayed response to zone issues"
      remediation_text: "Implement comprehensive AZ monitoring"
customer_environment_findings:
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""