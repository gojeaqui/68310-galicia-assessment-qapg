version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Scheduling"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "Adequate Measures in place to keep customer workloads off Infra Nodes"
  references: 
  - title: "Checking for taints & tolerations regarding infra nodes"
    url: "https://docs.openshift.com/container-platform/latest/nodes/scheduling/nodes-scheduler-taints-tolerations.html"
  - title: "Infrastructure Nodes in OpenShift 4"
    url: "https://access.redhat.com/solutions/5034771"
  check_procedures:
    - type: "command"
      question: ""
      command: |
        oc get nodes 
        oc describe nodes 
    - type: "survey"
      question: "Which nodes should be designated for Infra Nodes?"
  common_outcomes:
  - key: "nochange_01"
    scenario_description_short_text: "Cargas de trabajo no programadas en nodos de infraestructura"
    description_long_text: "Se ha configurado la aplicación para excluir las cargas de trabajo en nodos de infraestructura."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "require_01"
    scenario_description_short_text: "Workloads schedulable on Infra Nodes"
    description_long_text: "No configuration or incomplete configuration is done to exclude application workloads from being scheduled in Infrastructure Nodes. This could lead to breach to subscription contract."
    impact_and_risk_text: "Failure to properly label and taint the infrastructure nodes could lead to breach in subscription contract."
    remediation_text: "Label and taint nodes designated for infrastructure.  Ensure components such as the router, logging, and monitoring stacks have appropriate tolerances for these taints"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "nochange_01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc get nodes 
