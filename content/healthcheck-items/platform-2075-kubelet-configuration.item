version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Kubelet"
  severity_key: "Not defined"
  tags: []
  description: "Kubelet Configuration Overridden"
  references: 
  - title: "Managing nodes"
    url: "https://docs.openshift.com/container-platform/latest/nodes/nodes/nodes-nodes-managing.html"
  - title: "Freeing node resources using garbage collection"
    url: "https://docs.openshift.com/container-platform/latest/nodes/nodes/nodes-nodes-garbage-collection.html"
  check_procedures:
    - type: command
      command: |
        # check for custom kubelet configs
        oc get kubeletconfigs -A -o yaml
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "No se encontraron configuraciones de Kubelet"
      description_long_text: ""  # Consultant to fill out custom kubelet details
      impact_and_risk_text: ""
      remediation_text: ""
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "advisory01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
