version: v2
check_definition:
  category_key: "operation_ready"
  subcategory_key: "Skills"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "OpenShift Cluster Configuration"
  description: "Team Skills Operating Openshift"
  references: 
  - title: "List of positions which would support or utilize an OpenShift Container Platform and learning resources per position"
    url: "https://docs.openshift.com/container-platform/latest/welcome/learn_more_about_openshift.html"
  check_procedures:
    - type: "survey"
      question: "Inquire customer about team members previous experience with containers, kubernetes, linux, software development, pipelines and scm. Relevant experience would include years on an assignment utilizing these skillsets, certifications pursued to build knowledge, or general feelings about using or supporting an Openshift cluster."
    - type: "survey"
      question: "What OpenShift certifications does the team currently hold?"
    - type: "survey"
      question: "How experienced is the team with Linux system administration?"
    - type: "survey"
      question: "What is the team's experience level with CI/CD pipelines?"
    - type: "survey"
      question: "How familiar is the team with container security practices?"
    - type: "survey"
      question: "What monitoring and troubleshooting experience does the team have?"
    - type: "survey"
      question: "What training plans are in place for skill development?"
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "Team is ready"
    description_long_text: "Team has the experience and knowledge to support platform. Able to gather information regarding the teams experience and feel confident they can effectively support the platform based on the answers given."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "no_change02"
    scenario_description_short_text: "Strong Skill Base"
    description_long_text: "Team demonstrates comprehensive knowledge across required domains"
    impact_and_risk_text: "Low risk for platform operations"
    remediation_text: "Continue current training program"
  - key: "advisory01"
    scenario_description_short_text: "Skill Assessment Needed"
    description_long_text: "Detailed evaluation of team skills required"
    impact_and_risk_text: "Potential gaps in critical areas"
    remediation_text: "Conduct comprehensive skill assessment"
  - key: "changes_recommended01"
    scenario_description_short_text: "Team needs more assistance"
    description_long_text: "Based on answers from team members, it was found they have significant knowledge gaps in the core areas necessary for Openshift"
    impact_and_risk_text: "Lack of understanding on supporting and utilizing a cluster will lead to poor cluster performance and health. This will also impact the ability for the team to onboard customers and support their workloads."
    remediation_text: "Recommend client utilizes a Red Hat Learning Subscription to fill gaps. Recommend the team comes up with their own training plan to provide resources to fill knowledge gaps"
  - key: "changes_recommended02"
    scenario_description_short_text: "Certification Path Required"
    description_long_text: "Team lacks necessary OpenShift certifications"
    impact_and_risk_text: "Risk of suboptimal platform management"
    remediation_text: "Implement certification roadmap for team members"
customer_environment_findings:
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""