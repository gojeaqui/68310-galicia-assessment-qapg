version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Quotas & Limits"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Capacity Management"
  description: "Pod Disruption budget usage"
  references: []
  check_procedures:
    - type: survey
      question: "Document Pod Disruption Budget usage"
    - type: survey
      question: "Are PDBs configured for critical workloads?"
    - type: survey
      question: "What is the minimum availability percentage set in existing PDBs?"
    - type: survey
      question: "How many applications are currently protected by PDBs?"
    - type: survey
      question: "Are PDBs aligned with application SLAs?"
    - type: survey
      question: "Are there any workloads that need PDBs but don't have them configured?"
    - type: survey
      question: "What selector labels are used in PDBs to match pods?"
    - type: survey
      question: "Have there been any incidents where PDBs prevented successful node drains?"
    - type: command
      command: |
        oc get pdb -A
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Information Only" 
      description_long_text: ""  # Consultant to provide details
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "advisory02"
      scenario_description_short_text: "PDBs are configured but need review"
      description_long_text: "Pod Disruption Budgets are in place but require optimization"
      impact_and_risk_text: "Current PDB settings might not align with application SLAs"
      remediation_text: "Review and adjust PDB settings based on application requirements"
    - key: "no_change01"
      scenario_description_short_text: "Los presupuestos de interrupción de pods (PDBs o Pod Disruption Budget) están configurados correctamente"
      description_long_text: "Los presupuestos de interrupción de pods (PDBs) están bien configurados y alineados con las necesidades de la aplicación"
      impact_and_risk_text: "No se han identificado riesgos inmediatos"
      remediation_text: "Continuar supervisando la eficacia de los (PDBs)"
    - key: "no_change02"
      scenario_description_short_text: "PDBs are effectively protecting critical workloads"
      description_long_text: "Critical applications are properly protected with appropriate PDB settings"
      impact_and_risk_text: "Minimal risk during cluster maintenance"
      remediation_text: "Maintain current PDB configuration"
    - key: "changes_recommended01"
      scenario_description_short_text: "Missing PDBs for critical workloads"
      description_long_text: "Critical applications identified without PDB protection"
      impact_and_risk_text: "Risk of service disruption during cluster maintenance"
      remediation_text: "Implement PDBs for all critical workloads"
    - key: "changes_recommended02"
      scenario_description_short_text: "PDB settings need adjustment"
      description_long_text: "Current PDB configurations don't match workload requirements"
      impact_and_risk_text: "Potential service disruption or blocked maintenance operations"
      remediation_text: "Adjust minAvailable/maxUnavailable values based on application needs"
customer_environment_findings:
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
