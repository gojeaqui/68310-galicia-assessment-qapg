version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Network"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Network Policy"
  description: "Network Policy"
  references: 
  - title: "Network Policy usage in OpenShift"
    url: "https://docs.openshift.com/container-platform/latest/networking/network_security/network_policy/about-network-policy.html"
  check_procedures:
    - type: "command"
      command: |
        oc describe networkpolicy --all-namespaces
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Se utilizan NetworkPolicies"
      description_long_text: "Se encontró que se están utilizando NetworkPolicies para proteger los namespaces de la aplicación"  # Consultant to fill out details
      impact_and_risk_text: ""
      remediation_text: ""
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "advisory01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc describe networkpolicy --all-namespaces
