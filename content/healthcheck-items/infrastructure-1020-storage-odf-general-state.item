version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "storage"
  severity_key: "Not defined"
  tags: []
  description: "ODF General State Check"
  references:
  - title: "Red Hat OpenShift Data Foundation"
    url: "https://docs.openshift.com/container-platform/latest/storage/persistent_storage/persistent-storage-ocs.html"
  check_procedures:
    - type: survey
      question: "Verificar la salud general del clúster de ODF."
    - type: "command"
      command: |
        oc exec -n openshift-storage $(oc get pods -n openshift-storage -l app=rook-ceph-tools -o name) -- ceph status
        oc exec -n openshift-storage $(oc get pods -n openshift-storage -l app=rook-ceph-tools -o name) -- ceph health detail
        oc exec -n openshift-storage $(oc get pods -n openshift-storage -l app=rook-ceph-tools -o name) -- ceph df detail
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "ODF configurado apropiadamente"
      description_long_text: "ODF está instalado y configurado correctamente con capacidad de almacenamiento y redundancia adecuados"
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "no_change01"
      scenario_description_short_text: "El clúster de ODF se encuentra en estado 'HEALTH_OK'"
      description_long_text: "Se encontró que el estado de salud general del cluster de ODF es saludable y no se observaron errores."
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended01"
      scenario_description_short_text: "ODF necesita actualización"
      description_long_text: "La versión actual de ODF requiere una actualización para abordar los problemas conocidos o recibir nuevas funciones"
      impact_and_risk_text: "Ejecutar versiones desactualizadas puede hacer que falten correcciones o funciones importantes."
      remediation_text: "Actualizar ODF a la última versión compatible"
    - key: "changes_recommended02"
      scenario_description_short_text: "Revisión de configuración de ODF necesaria"
      description_long_text: "La configuración de ODF requiere una revisión para un rendimiento y confiabilidad óptimos"
      impact_and_risk_text: "La configuración subóptima puede afectar el rendimiento del almacenamiento"
      remediation_text: "Revise y optimice la configuración de ODF de acuerdo con las mejores prácticas"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [openshift@bastion ~]$ oc exec -n openshift-storage $(oc get pods -n openshift-storage -l app=rook-ceph-tools -o name) -- ceph status
      cluster:
        id:     372fc554-7a5f-480a-b82b-48a8170c7a8d
        health: HEALTH_OK
     
      services:
        mon: 3 daemons, quorum a,b,c (age 8w)
        mgr: a(active, since 8w)
        mds: 1/1 daemons up, 1 hot standby
        osd: 20 osds: 20 up (since 8w), 20 in (since 8w)
        rgw: 1 daemon active (1 hosts, 1 zones)
     
      data:
        volumes: 1/1 healthy
        pools:   12 pools, 585 pgs
        objects: 341.15k objects, 609 GiB
        usage:   1.8 TiB used, 308 TiB / 310 TiB avail
        pgs:     585 active+clean
     
      io:
        client:   2.7 KiB/s rd, 2.2 MiB/s wr, 4 op/s rd, 6 op/s wr
     
    ---

    [openshift@bastion ~]$ oc exec -n openshift-storage $(oc get pods -n openshift-storage -l app=rook-ceph-tools -o name) -- ceph health detail
    HEALTH_OK
    ---

