version: v2
check_definition:
  category_key: "appdev"
  subcategory_key: "Configuration Management"
  severity_key: "Not defined"
  tags: []
  description: "Application Automation Maturity"
  references:
    - title: "Using config maps with applications"
      url: "https://docs.openshift.com/container-platform/latest/applications/config-maps.html"
    - title: "Providing sensitive data to pods by using secrets"
      url: "https://docs.openshift.com/container-platform/latest/nodes/pods/nodes-pods-secrets.html"
  check_procedures:
    - type: survey
      question: "How do you manage configurations within Kubernetes? Config Maps vs Secrets"
    - type: survey
      question: "How often are configuration management practices reviewed and updated?"
    - type: survey
      question: "What tools are used to manage configuration changes in Kubernetes?"
    - type: survey
      question: "Are there any challenges faced in managing sensitive data using secrets?"
    - type: survey
      question: "How is access to configuration data controlled and audited?"
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Information Only"
      description_long_text: ""  # Consultant to describe how data is sent to applications.
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended01"
      scenario_description_short_text: "Revisiones de configuración poco frecuentes"
      description_long_text: "Las prácticas de gestión de la configuración no se revisan periódicamente."
      impact_and_risk_text: "Las revisiones poco frecuentes pueden dar lugar a prácticas obsoletas y posibles riesgos de seguridad."
      remediation_text: "Establecer un programa regular para revisar y actualizar las prácticas de gestión de la configuración."
    - key: "advisory02"
      scenario_description_short_text: "Revisar las herramientas de configuración"
      description_long_text: "Se recomienda revisar periódicamente las herramientas de gestión de la configuración para garantizar que satisfagan las necesidades actuales."
      impact_and_risk_text: ""
      remediation_text: "Evaluar las herramientas actuales y explorar nuevas opciones si es necesario."
    - key: "no_change01"
      scenario_description_short_text: "Gestión de la configuración adecuada"
      description_long_text: "Las prácticas actuales de gestión de la configuración son suficientes"
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended02"
      scenario_description_short_text: "Desafíos en la Gestión de Secretos"
      description_long_text: "Existen desafíos en la gestión de datos sensibles mediante secretos."
      impact_and_risk_text: "La gestión inadecuada de secretos puede generar vulnerabilidades de seguridad."
      remediation_text: "Implementar las mejores prácticas para la gestión de secretos y garantizar la implementación de controles de acceso adecuados."
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: tbe
  common_outcome_key: ""
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""