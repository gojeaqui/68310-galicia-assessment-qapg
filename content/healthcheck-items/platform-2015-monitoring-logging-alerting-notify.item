version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Monitoring & Logging"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Observability"
    - "Administration"
    - "Security"
  description: "Ensure OpenShift alerts are forwarded to an external system that is monitored"
  references: 
  - title: "Sending notifications to external systems"
    url: "https://docs.openshift.com/container-platform/latest/monitoring/managing-alerts.html#sending-notifications-to-external-systems_managing-alerts"
  check_procedures:
    - type: gui_action
      steps: |
        1. see alertmanager-main secret in openshift-monitoring namespace
        2. see cluster-monitoring-config configMap in openshift-monitoring namespace
    - type: "survey"
      question: "What external systems can be leveraged to receive OpenShift alerts (email/chat/pagerduty)"
    - type: command
      command: |
        oc get secret -n openshift-monitoring alertmanager-main -o yaml
        oc get configmap -n openshift-monitoring cluster-monitoring-config -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "Alertas externas configuradas"
    description_long_text: "Las alertas de OpenShift se envían a un sistema externo supervisado por los administradores responsables del mantenimiento de la plataforma."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "changes_recommended01"
    scenario_description_short_text: "Alertas externas configuradas, pero solo por mail"
    description_long_text: "Las alertas de OpenShift si bien se envían a un sistema externo como es el mail, se recomienda agregar receptores de alguna aplicacion como Teams o Telegram."
    impact_and_risk_text: "Cuando las alertas de OpenShift no se envían a los sistemas que supervisan los administradores de OpenShift, los problemas pueden pasar desapercibidos, lo que provoca interrupciones o una degradación del rendimiento de la plataforma."
    remediation_text: "Configurar los receptores de alertas en sistemas externos adicionales al mail"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    apiVersion: v1
    kind: Secret
    metadata:
      creationTimestamp: "2026-06-01T16:21:43Z"
      labels:
        app.kubernetes.io/component: alert-router
        app.kubernetes.io/instance: main
        app.kubernetes.io/managed-by: cluster-monitoring-operator
        app.kubernetes.io/name: alertmanager
        app.kubernetes.io/part-of: openshift-monitoring
        app.kubernetes.io/version: 0.28.1
      name: alertmanager-main
      namespace: openshift-monitoring
      resourceVersion: "31347420"
      uid: c58dfcb5-e742-424e-a54d-d8c05fa7ceb0
    type: Opaque
    data:
      alertmanager.yaml:
        global:
          http_config:
            proxy_from_environment: true
        inhibit_rules:
          - equal:
              - namespace
              - alertname
            source_matchers:
              - severity = critical
            target_matchers:
              - severity =~ warning|info
          - equal:
              - namespace
              - alertname
            source_matchers:
              - severity = warning
            target_matchers:
              - severity = info
        receivers:
          - name: Default
            webhook_configs:
              - url: >-
                  https://integrations.bigpanda.io/oim/prometheus/alerts?app_key=XX
                http_config:
                  bearer_token: XX
          - name: Watchdog
          - name: Critical
        route:
          group_by:
            - namespace
          group_interval: 5m
          group_wait: 30s
          receiver: Default
          repeat_interval: 12h
          routes:
            - matchers:
                - alertname = Watchdog
              receiver: Watchdog
            - matchers:
                - severity = critical
              receiver: Critical
