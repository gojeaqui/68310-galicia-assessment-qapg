  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Proxy"
  description: "Openshift Proxy Settings"
  references: 
  - title: "Creating cluster-wide proxy"
    url: "https://docs.openshift.com/container-platform/latest/networking/enable-cluster-wide-proxy.html"
  - title: "Configuring proxy override for Operators"
    url: "https://docs.openshift.com/container-platform/latest/operators/admin/olm-configuring-proxy-support.html"
  check_procedures:
    - type: "command"
      command: |
        oc describe proxy/cluster
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "El proxy está configurado según las especificaciones del cliente."
    description_long_text: "El proxy se ha configurado y los endpoints son los que el cliente espera."
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "Proxy configuration has not been setup or has the wrong endpoints"
    description_long_text: "The customer has not setup their proxy correctly."
    impact_and_risk_text: "Customer may experience issues pulling images and pulling from SCM in their organization if proxying is not setup correctly."
    remediation_text: "Work with customer to get proxy information and implement using the documentation linked."
