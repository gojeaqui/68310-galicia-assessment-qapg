version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "storage"
  severity_key: "Not defined"
  tags: []
  description: "Storage CSI Drivers"
  references: 
  - title: "Using Container Storage Interface (CSI)"
    url: "https://docs.openshift.com/container-platform/latest/storage/container_storage_interface/persistent-storage-csi.html"
  - title: "Managing the default storage class"
    url: " https://docs.openshift.com/container-platform/latest/storage/container_storage_interface/persistent-storage-csi-sc-manage.html"
  check_procedures:
    - type: survey
      question: "Which CSI drivers are in use?"
    - type: survey
      question: "Are the CSI drivers properly configured and up-to-date?"
    - type: survey
      question: "Have there been any issues with the current CSI drivers?"
    - type: survey
      question: "Is there a backup mechanism for CSI driver configurations?"
    - type: survey
      question: "How often are the CSI drivers reviewed and updated?"
    - type: command
      command: |
        oc get sc -o yaml
        oc get csinode -o yaml
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Se están utilizando los drivers CSI: csi.trident.netapp.io y csi.vsphere.vmware.com"
      description_long_text: "El upgrade de Openshift a version 4.14 realiza un upgrade transparente al driver CSI pero los features de alto nivel como expansion de volúmenes no quedan habilitados"  # Consultant to fill out storage driver details
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "no_change01"
      scenario_description_short_text: "Los controladores CSI están configurados correctamente"
      description_long_text: "Todos los controladores CSI están actualizados y configurados correctamente."
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended01"
      scenario_description_short_text: "Los drivers CSI necesitan ser actualizados"
      description_long_text: "Algunos controladores CSI no están en la última versión o requieren actualizaciones de configuración."
      impact_and_risk_text: "Los controladores desactualizados pueden no incluir funciones importantes o actualizaciones de seguridad."
      remediation_text: "Actualice los controladores CSI a las últimas versiones compatibles y revise las configuraciones."
    - key: "changes_recommended02"
      scenario_description_short_text: "Se necesita copia de seguridad del controlador CSI"
      description_long_text: "No existe un mecanismo de respaldo para las configuraciones del controlador CSI."
      impact_and_risk_text: "Riesgo de pérdida de configuración durante los cambios o fallas del sistema."
      remediation_text: "Implemente una solución de respaldo para las configuraciones del controlador CSI."
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "advisory01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
